# =====================================================
# 走啊 (zoua) · 高德开放平台 Key 占位模板
# 真实 Key 绝不入库！仅存 Serverless 环境变量（Vercel/Cloudflare）
# 申请：https://console.amap.com  → 应用管理 → 创建新应用
# =====================================================

# Web 服务 Key：仅用于 Serverless Proxy（serverless/api/*），禁止出现在前端代码
AMAP_WEB_KEY=

# JS API Key：用于浏览器加载高德底图，必须绑定域名白名单
# 白名单建议：localhost:5173 与预部署域名（如 zoua.github.io）
AMAP_JS_KEY=

# 扫描默认参数（可按需调整）
SCAN_RADIUS_KM=60
SCAN_SECTORS=12
CACHE_TTL_MINUTES=5
